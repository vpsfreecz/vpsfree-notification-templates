<%

def url(page, params = nil)
  @base_url + "?page=" + page + (params ? "&#{params}" : "")
end
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
    .mail-content h1, .mail-content h2, .mail-content h3, .mail-content h4, .mail-content h5, .mail-content h6 {
      margin: 15px 0 10px 0;
    }

    .mail-content p, .mail-content table, .mail-content ul, .mail-content ol, .mail-content dl, .mail-content fieldset {
      margin: 15px 0;
    }

    .mail-content table {
      display: block;
      max-width: 100%;
      overflow-x: auto;
      overflow-wrap: normal;
      border-collapse: collapse;
      border-spacing: 0;
      font-size: 100%;
    }

    .mail-content table.overview td {
      text-align: right;
    }

    .mail-content th {
      text-align: center;
      font-weight: bold;
    }

    .mail-content th, .mail-content td {
      padding: 3px 7px;
    }

    .mail-content td.title {
      font-weight: bold;
    }

    .mail-content dt {
      font-weight: bold;
    }

    .mail-content dd {
      margin-left: 30px;
    }

    .mail-content table th {
      background: #5EAFFF;
      color: #FFF;
    }

    .mail-content table th, .mail-content table td {
      border: 1px solid #B2DAFF;
    }
  </style>
</head>
<body style="margin:0;padding:24px 12px;background:#f3f5f7;color:#24313d;font-family:Arial,sans-serif;line-height:1.6;">
<table role="presentation" style="table-layout:fixed;width:100%;max-width:640px;margin:0 auto;background:#fff;border:1px solid #dce2e7;border-radius:8px;">
<tr><td style="padding:24px;">
<div class="mail-content" style="overflow-x:auto;overflow-wrap:anywhere;">
<h1>Payments overview</h1>
<dl>
  <dt>From:</dt>
  <dd><%= local_time(@start, "%Y-%m-%d %H:%M") %></dd>

  <dt>To:</dt>
  <dd><%= local_time(@end, "%Y-%m-%d %H:%M") %></dd>
</dl>

<h2>Incoming payments</h2>
<table class="overview">
  <tr>
    <th rowspan="2">QUEUED</th>
    <th rowspan="2">UNMATCHED</th>
    <th rowspan="2">PROCESSED</th>
    <th rowspan="2">IGNORED</th>
    <th rowspan="2">ACCEPTED</th>
    <th colspan="2">INCOME</th>
  </tr>
  <tr>
    <th>ACCEPTED</th>
    <th>TOTAL</th>
  </tr>
  <tr>
    <td><%= @queued.count %></td>
    <td><%= @unmatched.count %></td>
    <td><%= @processed.count %></td>
    <td><%= @ignored.count %></td>
    <td><%= @accepted.count %></td>
    <td><%= @accepted.sum('amount') %></td>
    <td><%= @incoming.sum('amount') %></td>
  </tr>
</table>

<% if @unmatched.count > 0 %>
  <h3>Unmatched</h3>
  <table>
    <tr>
      <th>FETCHED AT</th>
      <th>AMOUNT</th>
      <th>TYPE</th>
      <th>FROM</th>
      <th>VS</th>
      <th>COMMENT</th>
    </tr>
    <% @unmatched.each do |p| %>
      <tr>
        <td><%= local_time(p.created_at, '%Y-%m-%d %H:%M:%S') %></td>
        <td><%= p.amount %></td>
        <td><%= p.transaction_type %></td>
        <td><%= p.account_name %></td>
        <td><%= p.vs %></td>
        <td><%= p.comment %></td>
      </tr>
    <% end %>
  </table>
<% end %>

<% if @accepted.count > 0 %>
  <h3>Accepted</h3>
  <table>
    <tr>
      <th>ACCEPTED AT</th>
      <th>USER</th>
      <th>ACCOUNTED BY</th>
      <th>AMOUNT</th>
      <th>FROM</th>
      <th>TO</th>
    </tr>
    <% @accepted.each do |p| %>
      <tr>
        <td><%= local_time(p.created_at, '%Y-%m-%d %H:%M:%S') %></td>
        <td>
          <% if p.user_id %>
            <a href="<%= url("adminm", "action=edit&id=#{p.user_id}") %>"><%= "#{p.user_id} #{p.user.login}" %></a>
          <% else %>
            ---
          <% end %>
        </td>
        <td>
          <% if p.accounted_by_id %>
            <a href="<%= url("adminm", "action=edit&id=#{p.accounted_by_id}") %>"><%= "#{p.accounted_by_id} #{p.accounted_by.login}" %></a>
          <% else %>
            ---
          <% end %>
        </td>
        <td><%= p.amount %></td>
        <td><%= local_date(p.from_date, '%Y-%m-%d') %></td>
        <td><%= local_date(p.to_date, '%Y-%m-%d') %></td>
      </tr>
    <% end %>
  </table>
<% end %>
</div>
</td></tr>
</table>
</body>
</html>
