<!DOCTYPE html>
<html lang="cs">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
      .mail-content h1, .mail-content h2, .mail-content h3, .mail-content h4, .mail-content h5, .mail-content h6 {
        margin: 15px 0 10px 0;
      }

      .mail-content h3 {
        font-size: 18px;
      }

      .mail-content p, .mail-content table, .mail-content ul, .mail-content ol, .mail-content dl, .mail-content fieldset {
        margin: 15px 0;
      }

      .mail-content table {
        width: 100%;
        table-layout: auto;
        overflow-wrap: normal;
        border-collapse: collapse;
        border-spacing: 0;
        font-size: 14px;
      }

      .mail-content th {
        text-align: center;
        font-weight: bold;
      }

      .mail-content th, .mail-content td {
        padding: 3px 4px;
      }

      .mail-content table th {
        background: #5EAFFF;
        color: #FFF;
      }

      .mail-content table th, .mail-content table td {
        border: 1px solid #B2DAFF;
      }
    </style>
  </head>
  <body style="margin:0;padding:24px 12px;background:#f3f5f7;color:#24313d;font-family:Arial,sans-serif;line-height:1.6;">
<table role="presentation" style="table-layout:fixed;width:100%;max-width:640px;margin:0 auto;background:#fff;border:1px solid #dce2e7;border-radius:8px;">
<tr><td style="padding:24px;">
<div class="mail-content" style="overflow-x:auto;overflow-wrap:anywhere;">
    <p>Ahoj <%= @vps.user.login %>,</p>
    <p>
      ve VPS <%= @vps.id %> <%= @vps.hostname %> dochází paměť.
    </p>
    <p>
      <% if @all_oom_count == 1 -%>
      Byl zaznamenán <%= @all_oom_count %> případ
      <% elsif @all_oom_count <= 4 -%>
      Byly zaznamenány <%= @all_oom_count %> případy
      <% else -%>
      Bylo zaznamenáno <%= @all_oom_count %> případů
      <% end -%>
      vyčerpání paměti:
    </p>
    <table>
      <tr>
        <th>Datum a čas</th>
        <th>Akce</th>
        <th>Počet</th>
        <th>Více info</th>
      </tr>
      <% @selected_oom_reports.each do |r| -%>
        <tr>
          <td><%= local_time(r.created_at, '%Y-%m-%d %H:%M:%S %Z') %></td>
          <td><%= r.killed_name ? "Ukončen #{r.killed_name}" : 'Nic neukončeno' %></td>
          <td><%= r.count %></td>
          <td><a href="<%= @base_url %>?page=oom_reports&action=show&id=<%= r.id %>">Podrobnosti</a></td>
        </tr>
      <% end -%>
    </table>
<% if @all_oom_count != @selected_oom_count -%>
    <p>
      <% remaining_reports = @all_oom_count - @selected_oom_count -%>
      <% if remaining_reports == 1 -%>
      Následoval další
      <% elsif remaining_reports <= 4 -%>
      Následovaly další
      <% else -%>
      Následovalo dalších
      <% end -%>
      <a href="<%= @base_url %>?page=oom_reports&vps=<%= @vps.id %>&list=1">
      <%= @all_oom_count - @selected_oom_count %>
      <% if remaining_reports == 1 -%>
      případ
      <% elsif remaining_reports <= 4 -%>
      případy
      <% else -%>
      případů
      <% end -%>
      </a>.
    </p>
<% end -%>
    <p>
      S pozdravem<br>

      tým vpsFree.cz
    </p>
    <p style="font-size:12px;color:#596773;">
      (Tento mail automaticky rozesílá vpsAdmin, Tvoje odpověď se zašle na naši podporu)
    </p>
</div>
</td></tr>
</table>
</body>
</html>
