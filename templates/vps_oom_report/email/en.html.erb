<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
      .mail-content h1, .mail-content h2, .mail-content h3, .mail-content h4, .mail-content h5, .mail-content h6 {
        margin: 15px 0 10px 0;
      }

      .mail-content h3 {
        font-size: 18px;
      }

      .mail-content p, .mail-content table, .mail-content ul, .mail-content ol, .mail-content dl, .mail-content fieldset {
        margin: 15px 0;
      }

      .mail-content table {
        width: 100%;
        table-layout: auto;
        overflow-wrap: normal;
        border-collapse: collapse;
        border-spacing: 0;
        font-size: 14px;
      }

      .mail-content th {
        text-align: center;
        font-weight: bold;
      }

      .mail-content th, .mail-content td {
        padding: 3px 4px;
      }

      .mail-content table th {
        background: #5EAFFF;
        color: #FFF;
      }

      .mail-content table th, .mail-content table td {
        border: 1px solid #B2DAFF;
      }
    </style>
  </head>
  <body style="margin:0;padding:24px 12px;background:#f3f5f7;color:#24313d;font-family:Arial,sans-serif;line-height:1.6;">
<table role="presentation" style="table-layout:fixed;width:100%;max-width:640px;margin:0 auto;background:#fff;border:1px solid #dce2e7;border-radius:8px;">
<tr><td style="padding:24px;">
<div class="mail-content" style="overflow-x:auto;overflow-wrap:anywhere;">
    <p>Hi <%= @vps.user.login %>,</p>
    <p>
      VPS <%= @vps.id %> <%= @vps.hostname %> is running out of memory.
    </p>
    <p>
      <% if @all_oom_count == 1 -%>
      We've detected <%= @all_oom_count %> out of memory situation:
      <% else -%>
      We've detected <%= @all_oom_count %> out of memory situations:
      <% end -%>
    </p>
    <table>
      <tr>
        <th>Time</th>
        <th>Action</th>
        <th>Count</th>
        <th>More information</th>
      </tr>
      <% @selected_oom_reports.each do |r| -%>
        <tr>
          <td><%= local_time(r.created_at, '%Y-%m-%d %H:%M:%S %Z') %></td>
          <td><%= r.killed_name ? "Killed #{r.killed_name}" : "Nothing killed" %></td>
          <td><%= r.count %></td>
          <td><a href="<%= @base_url %>?page=oom_reports&action=show&id=<%= r.id %>">See details</a></td>
        </tr>
      <% end -%>
    </table>
<% if @all_oom_count != @selected_oom_count -%>
    <p>
      Followed by
      <a href="<%= @base_url %>?page=oom_reports&vps=<%= @vps.id %>&list=1">
      <%= @all_oom_count - @selected_oom_count %> more
      </a>.
    </p>
<% end -%>
    <p>
      Best regards,<br>

      vpsFree.cz team
    </p>
    <p style="font-size:12px;color:#596773;">
      (This is an automated mail from vpsAdmin, your reply will be sent to our support)
    </p>
</div>
</td></tr>
</table>
</body>
</html>
