<%
def url(page, params = nil)
  @base_url + "?page=" + page + (params ? "&#{params}" : "")
end

def duration(interval)
  d = interval / 86400
  h = interval / 3600 % 24
  m = interval / 60 % 60
  s = interval % 60

  if d > 0
    "%d days, %02d:%02d:%02d" % [d, h, m, s]
  else
    "%02d:%02d:%02d" % [h, m, s]
  end
end

def time(t)
  return '---' unless t
  local_time(t, "%Y-%m-%d %H:%M:%S")
end
%>
<!DOCTYPE html>
<html lang="en">
  <head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
      .mail-content h1, .mail-content h2, .mail-content h3, .mail-content h4, .mail-content h5, .mail-content h6 {
        margin: 15px 0 10px 0;
      }

      .mail-content h1 {
        font-size: 24px;
      }

      .mail-content h2 {
        font-size: 20px;
      }

      .mail-content p, .mail-content table, .mail-content ul, .mail-content ol, .mail-content dl, .mail-content fieldset {
        margin: 15px 0;
      }

      .mail-content table {
        overflow-wrap: normal;
        border-collapse: collapse;
        border-spacing: 0;
        font-size: 100%;
      }

      .mail-content th {
        text-align: center;
        font-weight: bold;
      }

      .mail-content th, .mail-content td {
        padding: 3px 7px;
      }

      .mail-content table th {
        background: #5EAFFF;
        color: #FFF;
      }

      .mail-content table th, .mail-content table td {
        border: 1px solid #B2DAFF;
      }

      .mail-content table.log tr td:nth-child(2) {
        text-align: right;
      }

      .mail-content .action {
        margin-left: 10%;
      }

      .mail-content .action a {
        text-decoration: none;
        border: 1px solid #000;
        background: #969678;
        color: #FFF;
        padding: 3px;
      }
    </style>
  </head>
  <body style="margin:0;padding:24px 12px;background:#f3f5f7;color:#24313d;font-family:Arial,sans-serif;line-height:1.6;">
<table role="presentation" style="table-layout:fixed;width:100%;max-width:640px;margin:0 auto;background:#fff;border:1px solid #dce2e7;border-radius:8px;">
<tr><td style="padding:24px;">
<div class="mail-content" style="overflow-x:auto;overflow-wrap:anywhere;">
    <h1>
      <%= @event.class_name %>
      #<a href="<%= url('adminvps', "action=info&veid=#{@event.object.id}") %>">
        <%= @event.object.id %>
      </a>:
      <%= @event.monitor.label %>
    </h1>

    <table>
      <tr>
        <th>Issue:</th>
        <td><%= @event.monitor.desc %></td>
      </tr>
      <tr>
        <th>Monitored since:</th>
        <td><%= time(@event.created_at) %></td>
      </tr>
      <tr>
        <th>Confirmed at:</th>
        <td><%= time(@event.closed_at) %></td>
      </tr>
      <tr>
        <th>Monitored period:</th>
        <td><%= duration(@event.closed_at - @event.created_at) %></td>
      </tr>
    </table>

    <h2>Log</h2>
    <table class="log">
      <tr>
        <th>Date</th>
        <th>CPU usage [%]</th>
      </tr>
      <% @event.monitored_event_logs.each do |log| %>
        <tr>
          <td><%= time(log.created_at) %></td>
          <td><%= (100 - log.value).round(2) %></td>
        </tr>
      <% end %>
    </table>
    <p>
      Acknowledge the issue to silence alerts until it is resolved.
    </p>
    <p class="action">
      <a href="<%= url('monitoring', "action=ack&id=#{@event.id}") %>">
        Acknowledge
      </a>
    </p>
    <p>
      Ignore this issue to silence alerts about this issue for good, whether
      it is ever resolved or not.
    </p>
    <p class="action">
      <a href="<%= url('monitoring', "action=ignore&id=#{@event.id}") %>">
        Ignore
      </a>
    </p>
</div>
</td></tr>
</table>
</body>
</html>
