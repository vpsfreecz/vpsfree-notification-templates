<% day_word = ->(days) { days == 1 ? 'den' : ((2..4).cover?(days) ? 'dny' : 'dní') } -%>
<!DOCTYPE html>
<html lang="cs">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"></head>
<body style="margin:0;padding:24px 12px;background:#f3f5f7;color:#24313d;font-family:Arial,sans-serif;line-height:1.6;">
<table role="presentation" style="width:100%;max-width:640px;margin:0 auto;background:#fff;border:1px solid #dce2e7;border-radius:8px;">
<tr><td style="padding:24px;">
<p>Ahoj <%= ERB::Util.html_escape((@user.login).to_s) %>,</p>
<p>VPS <%= ERB::Util.html_escape((@vps.id).to_s) %> <%= ERB::Util.html_escape((@vps.hostname).to_s) %> bylo vypnuto kvůli opakovaným incidentům.</p>
<p><strong><%= ERB::Util.html_escape((@incident_type_label).to_s) %></strong></p>
<% if [@warning_period_days, @stop_period_days, @incident_count_7d, @incident_count_30d].all? { |value| value.is_a?(Integer) && value >= 0 } &&
      [@warning_limit, @stop_limit].all? { |value| value.is_a?(Integer) && value.positive? } -%>
<table style="width:100%;border-collapse:collapse;table-layout:fixed;font-size:14px;line-height:1.4;">
<colgroup><col style="width:25%;"><col style="width:25%;"><col style="width:18%;"><col style="width:32%;"></colgroup>
<thead><tr>
<th scope="col" style="padding:8px 4px;text-align:left;border-bottom:2px solid #dce2e7;overflow-wrap:anywhere;">Období</th>
<th scope="col" style="padding:8px 4px;text-align:left;border-bottom:2px solid #dce2e7;overflow-wrap:anywhere;">Počet incidentů</th>
<th scope="col" style="padding:8px 4px;text-align:left;border-bottom:2px solid #dce2e7;overflow-wrap:anywhere;">Limit</th>
<th scope="col" style="padding:8px 4px;text-align:left;border-bottom:2px solid #dce2e7;overflow-wrap:anywhere;">Akce</th>
</tr></thead>
<tbody>
<tr>
<td style="padding:8px 4px;vertical-align:top;border-bottom:1px solid #dce2e7;overflow-wrap:anywhere;"><%= ERB::Util.html_escape(@warning_period_days.to_s) %> <%= day_word.call(@warning_period_days) %></td>
<td style="padding:8px 4px;vertical-align:top;border-bottom:1px solid #dce2e7;overflow-wrap:anywhere;"><%= ERB::Util.html_escape(@incident_count_7d.to_s) %></td>
<td style="padding:8px 4px;vertical-align:top;border-bottom:1px solid #dce2e7;overflow-wrap:anywhere;"><%= ERB::Util.html_escape(@warning_limit.to_s) %></td>
<td style="padding:8px 4px;vertical-align:top;border-bottom:1px solid #dce2e7;overflow-wrap:anywhere;">Upozornění</td>
</tr>
<tr>
<td style="padding:8px 4px;vertical-align:top;border-bottom:1px solid #dce2e7;overflow-wrap:anywhere;"><%= ERB::Util.html_escape(@stop_period_days.to_s) %> <%= day_word.call(@stop_period_days) %></td>
<td style="padding:8px 4px;vertical-align:top;border-bottom:1px solid #dce2e7;overflow-wrap:anywhere;"><%= ERB::Util.html_escape(@incident_count_30d.to_s) %></td>
<td style="padding:8px 4px;vertical-align:top;border-bottom:1px solid #dce2e7;overflow-wrap:anywhere;"><%= ERB::Util.html_escape(@stop_limit.to_s) %></td>
<td style="padding:8px 4px;vertical-align:top;border-bottom:1px solid #dce2e7;overflow-wrap:anywhere;">Vypnutí VPS</td>
</tr>
</tbody>
</table>
<% end -%>
<% if @stopped_at -%>
<p>Čas vypnutí: <%= ERB::Util.html_escape((local_time(@stopped_at, '%Y-%m-%d %H:%M:%S %Z')).to_s) %></p>
<% end -%>
<p>Taková zátěž narušuje provoz ostatních VPS na stejném nodu. Zkontroluj prosím využití paměti a nastavení služeb ve VPS. U webového serveru nebo aplikace může pomoci snížení počtu pracovních procesů.</p>
<p>Parametry VPS včetně paměti můžeš <a href="https://kb.vpsfree.cz/informace/platby#z_ceho_se_sklada_clensky_poplatek">násobit současně s navýšením členského příspěvku</a>.</p>
<p>VPS můžeš znovu spustit ve vpsAdminu.<% if @stop_enforced %> Pokud se incidenty opakují, může být znovu vypnuto.<% end %></p>
<p>Prosíme o řešení.</p>
<% incidents = if @contributor_snapshot_available
                 Array(@contributing_incidents).select { |incident| incident[:available] }
               elsif @trigger_incident && @trigger_incident[:available]
                 [@trigger_incident]
               else
                 []
               end -%>
<% if incidents.any? -%>
<p><strong>Incidenty<% if @contributor_snapshot_available %> (<%= ERB::Util.html_escape(incidents.length.to_s) %>/<%= ERB::Util.html_escape(@contributing_incident_count.to_s) %>)<% end %>:</strong></p>
<ul>
<% incidents.each do |incident| -%>
  <li>#<%= ERB::Util.html_escape(incident[:id].to_s) %><% if incident[:detected_at] %> | <%= ERB::Util.html_escape(local_time(incident[:detected_at], '%Y-%m-%d %H:%M:%S %Z')) %><% end %> | <%= ERB::Util.html_escape(incident[:subject].to_s.gsub(/[[:cntrl:]\u2028\u2029]/, ' ')) %>
<% if incident[:url] -%>
    <br><a href="<%= ERB::Util.html_escape(incident[:url]) %>">Podrobnosti</a>
<% end -%>
  </li>
<% end -%>
</ul>
<% end -%>
<% if @incident_history_url -%>
<p><a href="<%= ERB::Util.html_escape(@incident_history_url) %>">Přehled incidentů ve vpsAdminu</a></p>
<% end -%>
<p><a href="https://kb.vpsfree.cz/navody/vps/incidenty#oomd">Více informací v KB</a></p>
<p>S pozdravem<br>tým vpsFree.cz</p>
<p style="font-size:12px;color:#596773;">(Tento mail automaticky rozesílá vpsAdmin, Tvoje odpověď se zašle na naši podporu)</p>
</td></tr>
</table>
</body>
</html>
